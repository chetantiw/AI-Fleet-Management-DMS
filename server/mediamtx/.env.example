# Copy to .env (git-ignored) and adjust for this server. install_server.sh writes it for you.
# Public name of this server (WebRTC media address)
PUBLIC_HOST=iot.example.com
# Local port of the viewer login check (change if 9100 is taken)
AUTH_PORT=9100
# ThingsBoard as seen from this server
TB_LOCAL_URL=http://127.0.0.1:8080
